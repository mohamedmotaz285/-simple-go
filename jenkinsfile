pipeline {
    agent any

    environment {
        IMAGE_NAME = "mohamedmotaz350/simple-go"
        GO_PATH = "/usr/local/go/bin"
    }

    stages {
        stage('Install Go') {
            steps {
                script {
                    // تثبيت Go إذا كان غير موجود
                    sh 'if ! command -v go &> /dev/null; then sudo apt-get update && sudo apt-get install -y golang-go; fi'
                }
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/mohamedmotaz285/-simple-go.git'
            }
        }

        stage('Set Go Path') {
            steps {
                script {
                    // تأكد من أن Go موجود في PATH
                    sh 'export PATH=$PATH:/usr/local/go/bin'
                }
            }
        }

        stage('Run Unit Tests') {
            steps {
                script {
                    // قم بتثبيت الحزم المفقودة أو التحقق منها
                    sh 'go mod tidy'
                    // تنفيذ اختبارات الوحدة
                    sh 'go test ./...'
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker') {
                        def app = docker.build("${IMAGE_NAME}")
                        app.push()
                    }
                }
            }
        }
    }

    post {
        success {
            mail to: 'mohamedmotaz221@gmail.com',
                 subject: "Jenkins Pipeline Success: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "The Jenkins pipeline has completed successfully. Check it here: ${env.BUILD_URL}"
        }
        failure {
            mail to: 'mohamedmotaz221@gmail.com',
                 subject: "Jenkins Pipeline Failed: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                 body: "The Jenkins pipeline has failed. Check it here: ${env.BUILD_URL}"
        }
    }
}